{
  "name": "joe-os-now",
  "private": true,
  "version": "0.1.0",
  "description": "NOW-only native shell. Four screens. Wraps the live sheet and feeds. Does not clasp 6_APP.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "test": "node scripts/check.mjs && node scripts/contract.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
